# Copy to .env and fill in. .env is gitignored: never commit it.

# SSH host running Hermes, for scripts/deploy.py. Prefer an alias from ~/.ssh/config with key-based
# auth: the script connects with BatchMode=yes, so password prompts fail.
HERMES_HOST=hermes-vps

# Model the benchmark adapter sends requests to (the model Hermes runs with).
HERMES_MODEL=claude-sonnet-5-5

# For benchmark/hermes_adapter.py (runs the benchmark against the real model).
ANTHROPIC_API_KEY=
